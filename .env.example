# Same SQL env shape as Nile Chat (server/src/database/connection.js).
# These take priority over DB_CONNECTION when all four of SERVER/NAME/USER/PASSWORD are set.
DB_SERVER=
DB_PORT=1433
DB_NAME=ChatwootReports
DB_USER=
DB_PASSWORD=

# Fallback if the Nile Chat vars above are empty:
# DB_CONNECTION=Server=HOST,1433;Database=ChatwootReports;User Id=USER;Password=PASS;Encrypt=False;TrustServerCertificate=True;

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
JWT_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Nile Techno
